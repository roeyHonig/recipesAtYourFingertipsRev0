@model recipesAtYourFingertipsRev0.Models.CreateRecipeViewModel

@{
    ViewData["Title"] = "Add Recipe";
}

<div class="recipes-page">

    <h1>Add Recipe</h1>

    <form asp-action="Create" method="post">

        <div class="mb-3" dir="rtl">
            <label asp-for="Title" class="form-label" dir="rtl" style="text-align: right;">שם המתכון</label>
            <input asp-for="Title" class="form-control" dir="rtl"/>
            <span asp-validation-for="Title" class="text-danger" ></span>
        </div>

        <div class="mb-3" dir="rtl">
            <label asp-for="Ingredients" class="form-label" dir="rtl" style="text-align: right;">חומרים</label>
            <textarea asp-for="Ingredients"
                    class="form-control"
                    rows="8" dir="rtl"></textarea>
            <span asp-validation-for="Ingredients" class="text-danger"></span>
        </div>

        <div class="mb-3" dir="rtl">
            <label asp-for="Instructions" class="form-label" dir="rtl" style="text-align: right;">הוראות</label>
            <textarea asp-for="Instructions"
                    class="form-control"
                    rows="10" dir="rtl"></textarea>
            <span asp-validation-for="Instructions" class="text-danger"></span>
        </div>

        <button type="submit" class="btn btn-primary">
            Save Recipe
        </button>

        <a asp-action="Index" class="btn btn-secondary">
            Cancel
        </a>

    </form>

</div>