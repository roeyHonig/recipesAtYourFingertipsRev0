@model IEnumerable<recipesAtYourFingertipsRev0.Models.Recipe>

@{
    ViewData["Title"] = "My Recipes";
}

<div class="recipes-page" dir="rtl">

    <div class="recipes-header" dir="ltr">
        <h1>My Recipes</h1>

        <a asp-action="Create" class="btn btn-primary">
            + Add Recipe
        </a>

        <p>Hello, @ViewBag.AppUser.DisplayName!</p>
    </div>

    @if (!Model.Any())
    {
        <p>You haven't added any recipes yet.</p>
    }
    else
    {
        <div class="recipe-list">

            @foreach (var recipe in Model)
            {
                <div class="recipe-list-item">

                    <a asp-action="Details"
                       asp-route-id="@recipe.Id"
                       target="_blank"
                       class="recipe-button">
                        @recipe.Title
                    </a>

                    <a asp-action="Edit"
                       asp-route-id="@recipe.Id"
                       class="recipe-edit-button"
                       title="Edit recipe"
                       aria-label="Edit recipe">
                        ✎
                    </a>

                </div>
            }

        </div>
    }

</div>