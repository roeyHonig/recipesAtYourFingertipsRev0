@model recipesAtYourFingertipsRev0.Models.PaginatedRecipesViewModel

@if (Model.TotalPages > 1)
{
    <div class="recipes-pagination" dir="ltr">

        @if (Model.CurrentPage > 1)
        {
            <a asp-action="Index"
               asp-route-page="@(Model.CurrentPage - 1)"
               class="pagination-button">
                &lt; Previous
            </a>
        }

        @{
            var currentPage = Model.CurrentPage;
            var totalPages = Model.TotalPages;

            // Always show page 1.
            var pagesToShow = new HashSet<int> { 1, totalPages };

            // Show two pages before and two pages after the current page.
            for (var page = currentPage - 2; page <= currentPage + 2; page++)
            {
                if (page >= 1 && page <= totalPages)
                {
                    pagesToShow.Add(page);
                }
            }

            var orderedPages = pagesToShow.OrderBy(p => p).ToList();
        }

        @for (var i = 0; i < orderedPages.Count; i++)
        {
            var pageNumber = orderedPages[i];

            if (i > 0 && pageNumber > orderedPages[i - 1] + 1)
            {
                <span class="pagination-ellipsis">...</span>
            }

            <a asp-action="Index"
               asp-route-page="@pageNumber"
               class="pagination-button @(pageNumber == currentPage ? "active" : "")">
                @pageNumber
            </a>
        }

        @if (Model.CurrentPage < Model.TotalPages)
        {
            <a asp-action="Index"
               asp-route-page="@(Model.CurrentPage + 1)"
               class="pagination-button">
                Next &gt;
            </a>
        }

    </div>
}
