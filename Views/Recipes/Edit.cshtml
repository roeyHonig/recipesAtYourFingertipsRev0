@model recipesAtYourFingertipsRev0.Models.Recipe

@{
    ViewData["Title"] = "Edit Recipe";
}

<div class="recipe-form-page" dir="rtl">

    <h1>Edit Recipe</h1>

    <form asp-action="Edit" method="post">

        <input type="hidden" asp-for="Id" />

        <div class="recipe-form-field" dir="rtl">
            <label asp-for="Title">שם המתכון</label>
            <input asp-for="Title" dir="rtl" />
            <span asp-validation-for="Title"></span>
        </div>

        <div class="recipe-form-field" dir="rtl">
            <label asp-for="Ingredients">חומרים</label>
            <textarea asp-for="Ingredients"
                      dir="rtl"
                      rows="8"></textarea>
            <span asp-validation-for="Ingredients"></span>
        </div>

        <div class="recipe-form-field" dir="rtl">
            <label asp-for="Instructions">הוראות</label>
            <textarea asp-for="Instructions"
                      dir="rtl"
                      rows="10"></textarea>
            <span asp-validation-for="Instructions"></span>
        </div>

        <button type="submit" class="btn btn-primary">
            Save Changes
        </button>

    </form>

</div>