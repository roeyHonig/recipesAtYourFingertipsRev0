@{
    ViewData["Title"] = "Home";
}

<script>
    console.log("Browser URL:", window.location.href);
    console.log("ASP.NET Request Scheme:", "@ViewBag.RequestScheme");
    console.log("ASP.NET Request Host:", "@ViewBag.RequestHost");
    console.log("ASP.NET Request PathBase:", "@ViewBag.RequestPathBase");
</script>

<div class="home-page" dir="rtl">

    <h1>Recipes At Your Fingertips</h1>

    <p dir="ltr">Welcome to your recipe collection.</p>

    <a asp-controller="Account"
       asp-action="Login"
       asp-route-provider="Google"
       class="google-login-button">
        <span>G</span>
        Sign in with Google
    </a>
    <a asp-controller="Account"
        asp-action="Login"
        asp-route-provider="Microsoft"
        class="microsoft-login-button">
            <span class="microsoft-logo" aria-hidden="true">
                <span></span>
                <span></span>
                <span></span>
                <span></span>
            </span>
            Continue with Microsoft
    </a>

</div>